.DS_Store
# Raw videos stay out of git: upload compressed clips to the build log on github.com
*.mov
*.MOV
*.mp4
# Claude Code config and skills are personal: never commit them
.claude/
CLAUDE.md
# Python
__pycache__/
.venv/
.pytest_cache/
# Generated: the carcass body moved up (cad/base/build.py, for its check); the template's demo build
cad/base/out/body-lifted.stl
cad/_template/out/
# BambuStudio --info writes result.json in the working folder
result.json
.cad_verify_cache.pkl
.verify-last.txt
# Spanish copies of figures (--lang es) are for the private workshop kit; the scripts make them again
*-es.png
# Stage cache (tools/stage_cache.py) and carcass proxies (cad/robot.py): rebuilt on demand
cad/*/out/.cache/
cad/carcass-120/.proxy/
# Chassis: raw meshes and the coarse lite build are intermediate
cad/chassis/out/*-raw.ply
cad/chassis/out/*-lite.stl
# Chassis: coarse STL/STEP written while iterating (front-block-v2.step alone is 48 MB). The fine files that are
# printed are added at print time with `git add -f`.
cad/chassis/out/

# N0 mock-up: the body distance field (cad/mockup/n0.py), rebuilt on demand
cad/mockup/.cache/

# Design rounds (tools/rounds.py): snapshots, gates, views, judge briefs and scores are local; the build log keeps
# the round table (rounds.py status)
cad/*/rounds/
# Conversions from meshes (cad/README.md «From a mesh»): out/ is rebuilt by build.py, the heat maps by the gates;
# the STL/STEP of a printed version are added with `git add -f`, as for every design
cad/body/out/
cad/base/out/
cad/eyes/out/
cad/legs/out/
cad/*/images/fidelity-*.png
